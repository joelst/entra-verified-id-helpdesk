      "metadata": {
        "description": "Key Vault name (for post-deployment secret injection)."
      },
      "value": "[variables('kvName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "metadata": {
        "description": "Key Vault URI (matches KeyVault__Uri app setting)."
      },
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), '2023-07-01').vaultUri]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage Account name."
      },
      "value": "[variables('storageName')]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights connection string."
      },
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appiName')), '2020-02-02').ConnectionString]"
    }
  }
}