{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "5859884984328036478"
    }
  },
  "parameters": {
    "suffix": {
      "type": "string",
      "metadata": {
        "description": "Unique suffix appended to every resource name (e.g. \"helpdesk-prod\"). Keep it short: Key Vault names are capped at 24 characters."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "tenantId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra tenant ID."
      }
    },
    "clientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "App registration client ID (used by all three apps). Can be left empty and updated later via \"az webapp config appsettings set\"."
      }
    },
    "helpDeskGroupId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the Entra security group whose members are helpdesk agents. Can be left empty and updated later."
      }
    },
    "corporateIpRange": {
      "type": "string",
      "defaultValue": "0.0.0.0/0",
      "metadata": {
        "description": "IP CIDR range allowed to reach the Agent Portal. Use your corporate egress IP range."
      }
    },
    "credentialType": {
      "type": "string",
      "defaultValue": "EmployeeVerifiedCredential",
      "metadata": {
        "description": "Verifiable credential type name defined in your Entra Verified ID tenant."
      }
    },
    "didAuthority": {
      "type": "string",
      "metadata": {
        "description": "DID authority for your Verified ID tenant, e.g. \"did:web:yourdomain.com\"."
      }
    },
    "verifiedIdEnrollmentUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional public URL where callers can create or obtain your organization's Verified ID before starting verification."
      }
    },
    "senderEmail": {
      "type": "string",
      "metadata": {
        "description": "UPN of the mailbox used to send email notifications via Microsoft Graph."
      }
    },
    "senderUserId": {
      "type": "string",
      "metadata": {
        "description": "Entra object ID of the sender user account."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "S1",
      "allowedValues": [
        "S1",
        "S2",
        "S3",
        "P0v3",
        "P1v3",
        "P2v3",
        "B2"
      ],
      "metadata": {
        "description": "App Service plan SKU. S1 (Standard) is the recommended default — no special quota required and ~40% cheaper than P1v3. B2 (Basic tier) requires Basic VM quota which many subscriptions do not have."
      }
    },
    "storageRedundancy": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS"
      ],
      "metadata": {
        "description": "Storage account redundancy. LRS for dev/test; ZRS or GRS for production."
      }
    },
    "certName": {
      "type": "string",
      "defaultValue": "EntraClientCert",
      "metadata": {
        "description": "Name of the Entra app registration certificate in Key Vault. Must match the -CertName used in New-AppRegistration.ps1."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 24,
      "metadata": {
        "description": "Custom storage account name.Leave empty to auto-generate from the suffix (e.g. suffix \"helpdesk-dev\" → \"sthelpdesdev\"). Storage account names must be globally unique, 3–24 lowercase letters and digits only — no hyphens."
      }
    },
    "repoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/joelst/entra-verified-id-helpdesk",
      "metadata": {
        "description": "GitHub repository URL to deploy application code from. Defaults to the canonical repo. Change this if you have forked the repository."
      }
    },
    "repoBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Git branch to deploy from."
      }
    }
  },
  "variables": {
    "planName": "[format('asp-{0}', parameters('suffix'))]",
    "apiName": "[format('app-api-{0}', parameters('suffix'))]",
    "agentsName": "[format('app-agents-{0}', parameters('suffix'))]",
    "verifyName": "[format('app-verify-{0}', parameters('suffix'))]",
    "storageName": "[if(empty(parameters('storageAccountName')), format('st{0}', replace(parameters('suffix'), '-', '')), parameters('storageAccountName'))]",
    "kvName": "[format('kv-{0}', parameters('suffix'))]",
    "appiName": "[format('appi-{0}', parameters('suffix'))]",
    "logName": "[format('log-{0}', parameters('suffix'))]",
    "apiBaseUrl": "[format('https://{0}.azurewebsites.net', variables('apiName'))]",
    "agentsBaseUrl": "[format('https://{0}.azurewebsites.net', variables('agentsName'))]",
    "verifyBaseUrl": "[format('https://{0}.azurewebsites.net', variables('verifyName'))]",
    "tags": {
      "Application": "VerifiedIdHelpdesk",
      "ManagedBy": "Bicep"
    },
    "skuTier": "[if(startsWith(parameters('skuName'), 'P'), 'PremiumV3', if(startsWith(parameters('skuName'), 'S'), 'Standard', 'Basic'))]",
    "kvSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "kvCertificateUserRoleId": "db79e9a7-68ee-4b58-9aeb-b90e7c24fcba",
    "storageTableContributorRoleId": "0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appiName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]",
        "RetentionInDays": 30
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
