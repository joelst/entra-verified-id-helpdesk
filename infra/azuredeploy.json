            },
            {
              "name": "AgentPortal__BaseUrl",
              "value": "[variables('agentsBaseUrl')]"
            },
            {
              "name": "VerifyPortal__BaseUrl",
              "value": "[variables('verifyBaseUrl')]"
            },
            {
              "name": "Api__BaseUrl",
              "value": "[variables('apiBaseUrl')]"
            },
            {
              "name": "Notifications__SenderEmail",
              "value": "[parameters('senderEmail')]"
            },
            {
              "name": "Notifications__SenderUserId",
              "value": "[parameters('senderUserId')]"
            },
            {
              "name": "AzureAd__ClientCertificates__0__SourceType",
              "value": "KeyVault"
            },
            {
              "name": "AzureAd__ClientCertificates__0__KeyVaultUrl",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), '2023-07-01').vaultUri]"
            },
            {
              "name": "AzureAd__ClientCertificates__0__KeyVaultCertificateName",
              "value": "[parameters('certName')]"
            },
            {
              "name": "PROJECT",
              "value": "src/VerifiedIdHelpdesk.Api/VerifiedIdHelpdesk.Api.csproj"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appiName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('agentsName')]",
