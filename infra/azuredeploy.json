        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
