{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<REPLACE: your Entra tenant ID (GUID)>",
    "ClientId": "<REPLACE: AgentPortal app registration client ID (GUID)>",
    "CallbackPath": "/signin-oidc",
    "ClientCertificates": [
      {
        "SourceType": "KeyVault",
        "KeyVaultUrl": "https://<REPLACE: keyvault-name>.vault.azure.net/",
        "KeyVaultCertificateName": "EntraClientCert"
      }
    ]
  },
  "KeyVault": {
    "Uri": "https://<REPLACE: keyvault-name>.vault.azure.net/"
  },
  "Api": {
    "BaseUrl": "https://<REPLACE: api.yourdomain.com>",
    "Scopes": [
      "api://<REPLACE: app-registration-client-id>/access_as_agent"
    ]
  },
  "VerifyPortal": {
    "BaseUrl": "https://<REPLACE: verify.yourdomain.com>"
  },
  "AuthorizationGroups": {
    "HelpDeskAgents": "<REPLACE: Entra security group Object ID for helpdesk agents>"
  },
  "ApplicationInsights": {
    "ConnectionString": "<REPLACE: App Insights connection string>",
    "EnableAdaptiveSampling": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}