@model CreateVerificationViewModel
@{
    ViewData["Title"] = "New Verification Request";
    ViewData["CurrentStep"] = 1;
}

<partial name="_StepIndicator" />

<div class="card">
    <div class="card-title">New Verification Request</div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Hidden fields populated by directory search -->
        <input type="hidden" asp-for="CallerEntraId" id="callerEntraId" />
        <input type="hidden" asp-for="CallerEmail" id="callerEmail" />
        <input type="hidden" asp-for="CallerDisplayName" id="callerDisplayName" />

        <div class="form-group">
            <label class="form-label">Caller Name or Email</label>
            <input type="text" id="callerSearch" class="form-control"
                   placeholder="Start typing a name or email address..." autocomplete="off" />
            <div id="searchResults" class="search-results" style="display:none;"></div>
            <div id="selectedCaller" class="alert alert-info" style="display:none;margin-top:8px;"></div>
            <div id="manualEntry" style="display:none;margin-top:8px;">
                <small style="color:var(--color-text-muted);">Enter the caller's email manually:</small>
                <input type="email" id="manualEmail" class="form-control" style="margin-top:4px;"
                       placeholder="caller@yourdomain.com" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="TicketId" class="form-label">Ticket ID (optional)</label>
            <input asp-for="TicketId" class="form-control" placeholder="e.g. INC-12345" />
        </div>

        <div class="form-group">
            <label asp-for="Note" class="form-label">Note (optional, max 500 chars)</label>
            <textarea asp-for="Note" class="form-control" rows="3" maxlength="500"
                      placeholder="Reason for verification or additional context..."></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Delivery Channel</label>
            <div class="channel-options">
                <label class="channel-option">
                    <input type="radio" asp-for="DeliveryChannel" value="email" checked />
                    <span>📧 Email</span>
                </label>
                <label class="channel-option">
                    <input type="radio" asp-for="DeliveryChannel" value="teams" />
                    <span>💬 Microsoft Teams</span>
                </label>
                <label class="channel-option">
                    <input type="radio" asp-for="DeliveryChannel" value="verbal" />
                    <span>🗣️ Read to Caller</span>
                </label>
                <label class="channel-option channel-disabled" title="SMS coming soon">
                    <input type="radio" asp-for="DeliveryChannel" value="sms" disabled />
                    <span>📱 SMS <small>(coming soon)</small></span>
                </label>
            </div>
        </div>

        @Html.ValidationSummary(false, null, new { @class = "alert alert-error" })

        <button type="submit" id="submitBtn" class="btn btn-primary" disabled>
            Send Verification Request
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/directory-search.js" asp-append-version="true"></script>
}
