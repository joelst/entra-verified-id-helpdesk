@page
@model PresentModel
@{
    ViewData["Title"] = "Present Your Credential";
}

<div class="card" id="presentData" data-session-id="@Model.SessionId" data-api-base-url="@Model.ApiBaseUrl"
     data-expires-at="@Model.ExpiresAt.ToUniversalTime().ToString("O")">
    <div class="card-title">Present Your Credential</div>

    <div class="alert alert-info">
        Open <strong>Microsoft Authenticator</strong> on your phone and scan the QR code below,
        or tap the button to open Authenticator directly.
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.EnrollmentUrl))
    {
        <div class="alert alert-warning">
            Don’t have your Verified ID yet?
            <a href="@Model.EnrollmentUrl" target="_blank" rel="noopener noreferrer">Create it here</a>,
            then return to this page to continue.
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.QrCodeUri))
    {
        <div style="text-align:center; margin: 24px 0;">
            <img src="@Model.QrCodeUri" alt="Verification QR Code"
                 style="max-width:220px; border: 2px solid var(--color-border); border-radius: var(--radius); padding: 8px;" />
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.DeepLink))
    {
        <div style="text-align:center; margin-bottom: 20px;">
            <a href="@Model.DeepLink" class="btn btn-accent">
                Open Microsoft Authenticator
            </a>
        </div>
    }

    <div class="countdown" id="countdown"></div>

    <div id="statusMsg" style="display:none; margin-top:16px;"></div>
</div>

@section Scripts {
    <script src="~/js/present.js" asp-append-version="true"></script>
}
