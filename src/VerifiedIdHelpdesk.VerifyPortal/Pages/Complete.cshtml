@page
@model CompleteModel
@{
    ViewData["Title"] = "Identity Verified";
}

<div class="card">
    <div class="card-title">Verification Complete</div>

    <div class="result-verified">
        <div class="result-name" style="font-size: 24px;">✓ Your identity has been verified</div>
        <div class="result-meta" style="margin-top: 12px;">
            You may now return to your call with the helpdesk agent.
        </div>
    </div>

    <div style="margin-top: 24px;">
        <p style="color: var(--color-text-muted); font-size: var(--font-size-sm);">
            You can close this window.
        </p>
    </div>
</div>
