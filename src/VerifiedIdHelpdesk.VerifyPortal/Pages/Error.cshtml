@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="card">
    <div class="card-title">Something went wrong</div>

    <div class="alert alert-error">
        An error occurred while processing your request. Please try again or contact your helpdesk agent.
    </div>

    @* SECURITY: Never show exception details, stack traces, or internal paths.
       The development exception page is enabled automatically in Development environment
       via app.UseExceptionHandler() — no action required here. *@

    <a href="/" class="btn btn-primary" style="margin-top: 16px;">Back to Start</a>
</div>
