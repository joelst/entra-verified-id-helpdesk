root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# XML project files
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,tasks,targets,props}]
indent_size = 2

# Code files
[*.{cs,csx,vb,vbx}]
indent_size = 4
insert_final_newline = true
charset = utf-8-bom

# Test project configuration
[**/tests/**/*.cs]
# CA1707: Identifiers should not contain underscores (used in test names intentionally)
dotnet_diagnostic.CA1707.severity = none
# CA1051: Do not declare visible instance fields
dotnet_diagnostic.CA1051.severity = none

# General C# Formatting
[*.cs]
# Default C# code style
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
